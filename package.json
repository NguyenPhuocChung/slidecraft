{
  "name": "slidecraft-ai-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "test:server": "vitest run server/tests",
    "dev:all": "npx concurrently -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/build-icons.mjs",
    "verify:pptx": "python3 scripts/verify-pptx.py",
    "start": "tsx server/index.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron desktop-app",
    "dist:win": "npm run desktop:prepare && electron-builder --win --x64",
    "dist:linux": "npm run desktop:prepare && electron-builder --linux"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@uiw/react-codemirror": "^4.25.12",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fast-xml-parser": "^5.12.0",
    "framer-motion": "^14.13.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.10",
    "jsonc-parser": "^3.3.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
