# ---------- SlideCraft AI Studio — server ----------
PORT=4000
# development | production | test
NODE_ENV=development
# REQUIRED in production (the server refuses to start without it). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Optional. When set, the MongoDB/Mongoose driver is used; otherwise JSON files in DATA_DIR.
MONGODB_URI=
# File-driver storage and uploaded assets (defaults: server/data, server/uploads)
DATA_DIR=
UPLOAD_DIR=
# Comma-separated list of allowed browser origins for the API
CORS_ORIGIN=http://localhost:5173

# ---------- Image providers (optional; Openverse + Wikimedia work without keys) ----------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- Integrated AI (optional, future features; keys stay on the server) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---------- Frontend ----------
# API base URL used by the web app (default: /api, proxied by Vite to PORT)
VITE_API_URL=/api
